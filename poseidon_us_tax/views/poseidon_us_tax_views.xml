<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="poseidon_us_tax_profile_view_list" model="ir.ui.view">
    <field name="name">poseidon.us.tax.profile.list</field>
    <field name="model">poseidon.us.tax.profile</field>
    <field name="arch" type="xml">
      <list>
        <field name="company_id"/>
        <field name="entity_type"/>
        <field name="activity_tag"/>
        <field name="tax_regime"/>
        <field name="accounting_method"/>
        <field name="subject_to_sales_tax"/>
        <field name="subject_to_business_tax"/>
        <field name="state_code"/>
        <field name="federal_ein"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="poseidon_us_tax_profile_view_form" model="ir.ui.view">
    <field name="name">poseidon.us.tax.profile.form</field>
    <field name="model">poseidon.us.tax.profile</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="company_id"/>
              <field name="entity_type"/>
              <field name="activity_tag"/>
              <field name="tax_regime"/>
              <field name="accounting_method"/>
              <field name="subject_to_sales_tax"/>
              <field name="subject_to_business_tax"/>
              <field name="active"/>
            </group>
            <group>
              <field name="fiscal_year_end_month"/>
              <field name="fiscal_year_end_day"/>
              <field name="state_code"/>
              <field name="federal_ein"/>
            </group>
          </group>
          <field name="notes" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="poseidon_us_tax_ruleset_view_list" model="ir.ui.view">
    <field name="name">poseidon.us.tax.ruleset.list</field>
    <field name="model">poseidon.us.tax.ruleset</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="version"/>
        <field name="tax_year"/>
        <field name="jurisdiction"/>
        <field name="state_code"/>
        <field name="entity_type"/>
        <field name="rate_model"/>
        <field name="status"/>
      </list>
    </field>
  </record>

  <record id="poseidon_us_tax_ruleset_view_form" model="ir.ui.view">
    <field name="name">poseidon.us.tax.ruleset.form</field>
    <field name="model">poseidon.us.tax.ruleset</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="status != 'draft'"/>
          <button name="action_deprecate" string="Deprecate" type="object" invisible="status != 'active'"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,active,deprecated"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="version"/>
              <field name="tax_year"/>
              <field name="scope"/>
              <field name="status" readonly="1"/>
            </group>
            <group>
              <field name="jurisdiction"/>
              <field name="state_code"/>
              <field name="entity_type"/>
              <field name="effective_from"/>
              <field name="effective_to"/>
            </group>
          </group>
          <group string="Rates">
            <field name="rate_model"/>
            <field name="flat_rate"/>
            <field name="brackets_json"/>
            <field name="rules_json"/>
          </group>
          <group string="Activation">
            <field name="activated_at"/>
            <field name="activated_by_id"/>
          </group>
          <field name="notes" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="poseidon_us_tax_forecast_view_list" model="ir.ui.view">
    <field name="name">poseidon.us.tax.forecast.list</field>
    <field name="model">poseidon.us.tax.forecast</field>
    <field name="arch" type="xml">
      <list>
        <field name="generated_at"/>
        <field name="company_id"/>
        <field name="tax_year"/>
        <field name="status"/>
        <field name="taxable_base"/>
        <field name="estimated_liability"/>
        <field name="effective_rate"/>
        <field name="confidence_score"/>
      </list>
    </field>
  </record>

  <record id="poseidon_us_tax_forecast_view_form" model="ir.ui.view">
    <field name="name">poseidon.us.tax.forecast.form</field>
    <field name="model">poseidon.us.tax.forecast</field>
    <field name="arch" type="xml">
      <form create="0" edit="0">
        <header>
          <button name="action_mark_reviewed" string="Mark Reviewed" type="object" class="btn-primary" invisible="status != 'draft'"/>
          <button name="action_mark_filed" string="Mark Externally Filed" type="object" invisible="status != 'reviewed'"/>
          <field name="status" widget="statusbar" statusbar_visible="draft,reviewed,filed"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="company_id"/>
              <field name="profile_id"/>
              <field name="ruleset_id"/>
              <field name="period_id"/>
              <field name="tax_year"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="generated_at"/>
              <field name="generated_by_id"/>
              <field name="inputs_hash"/>
            </group>
          </group>
          <group string="Planning totals">
            <field name="income_total"/>
            <field name="deduction_total"/>
            <field name="credit_total"/>
            <field name="adjustment_total"/>
            <field name="taxable_base"/>
            <field name="estimated_liability"/>
            <field name="effective_rate"/>
            <field name="confidence_score"/>
          </group>
          <notebook>
            <page string="Drivers" name="drivers">
              <field name="drivers_json"/>
              <field name="missing_inputs"/>
            </page>
            <page string="Facts" name="facts">
              <field name="fact_ids">
                <list>
                  <field name="account_id"/>
                  <field name="category"/>
                  <field name="amount"/>
                  <field name="source"/>
                </list>
              </field>
            </page>
            <page string="Disclaimer" name="disclaimer">
              <field name="disclaimer" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_poseidon_us_tax_profiles" model="ir.actions.act_window">
    <field name="name">Poseidon US Tax Profiles</field>
    <field name="res_model">poseidon.us.tax.profile</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_poseidon_us_tax_rulesets" model="ir.actions.act_window">
    <field name="name">Poseidon US Tax Rulesets</field>
    <field name="res_model">poseidon.us.tax.ruleset</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_poseidon_us_tax_forecasts" model="ir.actions.act_window">
    <field name="name">Poseidon US Tax Forecasts</field>
    <field name="res_model">poseidon.us.tax.forecast</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_poseidon_us_tax_root" name="Poseidon US Tax" parent="account.menu_finance_configuration" groups="account.group_account_manager" sequence="90"/>
  <menuitem id="menu_poseidon_us_tax_profiles" name="Profiles" parent="menu_poseidon_us_tax_root" action="action_poseidon_us_tax_profiles" sequence="10"/>
  <menuitem id="menu_poseidon_us_tax_rulesets" name="Rulesets" parent="menu_poseidon_us_tax_root" action="action_poseidon_us_tax_rulesets" sequence="20"/>
  <menuitem id="menu_poseidon_us_tax_forecasts" name="Forecasts" parent="menu_poseidon_us_tax_root" action="action_poseidon_us_tax_forecasts" sequence="30"/>
</odoo>
