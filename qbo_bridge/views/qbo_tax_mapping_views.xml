<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_qbo_tax_mapping_list" model="ir.ui.view">
    <field name="name">qbo.tax.mapping.list</field><field name="model">qbo.tax.mapping</field>
    <field name="arch" type="xml"><list><field name="company_id"/><field name="realm_id"/>
      <field name="source_tax_code"/><field name="direction"/><field name="tax_ids" widget="many2many_tags"/><field name="active"/></list></field>
  </record>
  <record id="view_qbo_tax_mapping_form" model="ir.ui.view">
    <field name="name">qbo.tax.mapping.form</field><field name="model">qbo.tax.mapping</field>
    <field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="realm_id"/>
      <field name="source_tax_code"/><field name="direction"/><field name="tax_ids" widget="many2many_tags"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_qbo_tax_mapping" model="ir.actions.act_window">
    <field name="name">Tax translations</field><field name="res_model">qbo.tax.mapping</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
