<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_meridian_saas" model="ir.module.category">
            <field name="name">Meridian Workspace</field>
            <field name="sequence">95</field>
        </record>

        <record id="privilege_meridian_saas" model="res.groups.privilege">
            <field name="name">Meridian Workspace</field>
            <field name="category_id" ref="module_category_meridian_saas"/>
        </record>

        <!--
             Meridian role groups — the single source of permission truth.

             Each role group carries its Odoo permission chain via implied_ids;
             the controller assigns exactly ONE of these per user (see
             _resolve_role_groups).  Views, menus, and record rules should
             reference these groups.  Changing a user's role swaps one group and
             Odoo's implied-group closure re-derives every permission.
        -->

        <record id="group_meridian_saas_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="sequence">1</field>
            <field name="privilege_id" ref="privilege_meridian_saas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_readonly'))]"/>
        </record>

        <record id="group_meridian_saas_invoicing" model="res.groups">
            <field name="name">Invoicing</field>
            <field name="sequence">2</field>
            <field name="privilege_id" ref="privilege_meridian_saas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_meridian_saas_member" model="res.groups">
            <field name="name">Member</field>
            <field name="sequence">3</field>
            <field name="privilege_id" ref="privilege_meridian_saas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_user'))]"/>
        </record>

        <!-- QBO Bridge groups are implied here because these roles ARE the
             permission truth for a workspace: without the wiring no role could
             read qbo.realm, so /qbo/connect answered "You are not allowed to
             access 'QBO Realm'" for everyone except the root/admin users
             hardcoded in qbo_security.xml. Accountant works an existing
             connection (read realm, run imports, resolve conflicts); Manager
             also authorises and configures one (realm + mapping CRUD). -->
        <record id="group_meridian_saas_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="sequence">4</field>
            <field name="privilege_id" ref="privilege_meridian_saas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_manager')), (4, ref('qbo_bridge.group_qbo_bridge_user'))]"/>
        </record>

        <record id="group_meridian_saas_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">5</field>
            <field name="privilege_id" ref="privilege_meridian_saas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_manager')), (4, ref('base.group_erp_manager')), (4, ref('base.group_partner_manager')), (4, ref('qbo_bridge.group_qbo_bridge_manager'))]"/>
        </record>
    </data>
</odoo>
