<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="poseidon_kernel_res_bank_form" model="ir.ui.view">
    <field name="name">poseidon.kernel.res.bank.form</field>
    <field name="model">res.bank</field>
    <field name="inherit_id" ref="base.view_res_bank_form"/>
    <field name="arch" type="xml">
      <field name="bic" position="after">
        <field name="institution_category"/>
      </field>
    </field>
  </record>
  <record id="poseidon_kernel_res_bank_tree" model="ir.ui.view">
    <field name="name">poseidon.kernel.res.bank.list</field>
    <field name="model">res.bank</field>
    <field name="inherit_id" ref="base.view_res_bank_tree"/>
    <field name="arch" type="xml">
      <field name="bic" position="after">
        <field name="institution_category"/>
      </field>
    </field>
  </record>
</odoo>
