<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qbo_standard_account_search" model="ir.ui.view">
        <field name="name">qbo.standard.account.search</field>
        <field name="model">qbo.standard.account</field>
        <field name="arch" type="xml">
            <search string="Master Chart of Accounts">
                <field name="code" string="Code / Name"
                       filter_domain="['|', ('code', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="description"/>
                <field name="category"/>
                <field name="subcategory"/>
                <field name="parent_id"/>
                <field name="odoo_account_type"/>
                <field name="tags"/>

                <filter name="filter_header" string="Headers"
                        domain="[('entry_type', '=', 'header')]"/>
                <filter name="filter_detail" string="Details"
                        domain="[('entry_type', '=', 'detail')]"/>
                <filter name="filter_mapped" string="Mapped to Rules"
                        domain="[('bridge_rule_ids', '!=', False)]"/>
                <filter name="filter_linked" string="Linked to Companies"
                        domain="[('linked_account_ids', '!=', False)]"/>
                <separator/>
                <filter name="filter_asset" string="Assets"
                        domain="[('category', '=', 'Asset')]"/>
                <filter name="filter_liability" string="Liabilities"
                        domain="[('category', '=', 'Liability')]"/>
                <filter name="filter_equity" string="Equity"
                        domain="[('category', '=', 'Equity')]"/>
                <filter name="filter_revenue" string="Revenue"
                        domain="[('category', '=', 'Revenue')]"/>
                <filter name="filter_cogs" string="COGS"
                        domain="[('category', '=', 'Cost of Goods Sold')]"/>
                <filter name="filter_expense" string="Expenses"
                        domain="[('category', '=', 'Expense')]"/>
                <filter name="filter_other" string="Other"
                        domain="[('category', '=', 'Other')]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category'}"/>
                <filter name="group_subcategory" string="Subcategory"
                        context="{'group_by': 'subcategory'}"/>
                <filter name="group_type" string="Account Type"
                        context="{'group_by': 'entry_type'}"/>
                <filter name="group_parent" string="Parent Header"
                        context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_qbo_standard_account_list" model="ir.ui.view">
        <field name="name">qbo.standard.account.list</field>
        <field name="model">qbo.standard.account</field>
        <field name="arch" type="xml">
            <list string="Master Chart of Accounts"
                  default_order="code asc, entry_type desc"
                  decoration-muted="entry_type == 'header'">
                <field name="code"/>
                <field name="description"/>
                <field name="entry_type" string="Type" widget="badge"
                       decoration-success="entry_type == 'header'"
                       decoration-info="entry_type == 'detail'"/>
                <field name="category"/>
                <field name="kernel_layer" optional="show"/>
                <field name="kernel_required" optional="show"/>
                <field name="parent_id" string="Parent Header" optional="show"/>
                <field name="subcategory" optional="show"/>
                <field name="odoo_account_type" string="Odoo Type" optional="show"/>
                <field name="normal_balance" optional="show"/>
                <field name="activity_tag" string="L3 Activity" optional="hide"/>
                <field name="functional_group" string="L3 Group" optional="hide"/>
                <field name="rollup_to_l1_parent" string="L3 Rollup" optional="hide"/>
                <field name="dashboard_account_sets" string="L3 Sets" optional="hide"/>
                <field name="child_count" string="Children" optional="show"/>
                <field name="bridge_rule_count" string="Rules" optional="show"/>
                <field name="linked_account_count" string="Company Accts" optional="show"/>
                <field name="journal_item_count" string="Journal Items" optional="show"/>
                <button name="action_open_sync_wizard"
                        type="object"
                        string="Sync"
                        icon="fa-cloud-upload"
                        invisible="entry_type != 'detail'"/>
            </list>
        </field>
    </record>

    <record id="view_qbo_standard_account_kanban" model="ir.ui.view">
        <field name="name">qbo.standard.account.kanban</field>
        <field name="model">qbo.standard.account</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category"
                    class="o_kanban_small_column qbo_master_chart_kanban"
                    quick_create="false"
                    group_create="false">
                <field name="code"/>
                <field name="description"/>
                <field name="entry_type"/>
                <field name="category"/>
                <field name="subcategory"/>
                <field name="fs_mapping"/>
                <field name="normal_balance"/>
                <field name="bridge_rule_count"/>
                <field name="linked_account_count"/>
                <field name="journal_item_count"/>
                <field name="category_slug"/>

                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_kanban_record qbo_mc_card_#{record.category_slug.value}">
                            <div class="o_kanban_card_header">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold fs-5 text-truncate"
                                          style="max-width:90px"
                                          t-esc="record.code.value"/>
                                    <span t-if="record.entry_type.raw_value == 'header'"
                                          class="badge bg-secondary ms-auto">Header</span>
                                    <span t-if="record.entry_type.raw_value == 'detail'"
                                          class="badge bg-primary ms-auto">Detail</span>
                                </div>
                            </div>
                            <div class="o_kanban_card_content p-3">
                                <strong t-esc="record.description.value" class="d-block text-truncate"/>
                                <small class="text-muted qbo_mc_meta d-block"
                                       t-esc="record.subcategory.value or record.fs_mapping.value"/>
                                <div class="d-flex mt-2 gap-2 flex-wrap">
                                    <span t-if="record.fs_mapping.value"
                                          class="badge rounded-pill bg-light text-dark border"
                                          t-esc="record.fs_mapping.value"/>
                                    <span t-if="record.normal_balance.value"
                                          t-attf-class="badge rounded-pill #{record.normal_balance.raw_value == 'debit' ? 'bg-info' : 'bg-warning text-dark'}"
                                          t-esc="record.normal_balance.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer d-flex justify-content-between align-items-center px-3 pb-3">
                                <div class="d-flex gap-3 flex-wrap text-muted small">
                                    <span t-if="record.bridge_rule_count.value">
                                        <i class="fa fa-random me-1"/>
                                        <t t-esc="record.bridge_rule_count.value"/>
                                    </span>
                                    <span t-if="record.linked_account_count.value">
                                        <i class="fa fa-building-o me-1"/>
                                        <t t-esc="record.linked_account_count.value"/>
                                    </span>
                                    <span t-if="record.journal_item_count.value">
                                        <i class="fa fa-list me-1"/>
                                        <t t-esc="record.journal_item_count.value"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_qbo_standard_account_form" model="ir.ui.view">
        <field name="name">qbo.standard.account.form</field>
        <field name="model">qbo.standard.account</field>
        <field name="arch" type="xml">
            <form string="Master Account">
                <header>
                    <button name="action_open_sync_wizard"
                            string="Sync to Mappings / QBO"
                            type="object"
                            class="btn-primary"
                            invisible="entry_type != 'detail'"/>
                    <button name="action_open_import_wizard"
                            string="Import / Refresh Master Chart"
                            type="object"
                            class="btn-secondary"/>
                    <field name="entry_type" widget="statusbar" statusbar_visible="header,detail"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_bridge_rules" icon="fa-random"
                                invisible="bridge_rule_count == 0">
                            <field name="bridge_rule_count" widget="statinfo" string="Bridge Rules"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_linked_accounts" icon="fa-building-o"
                                invisible="linked_account_count == 0">
                            <field name="linked_account_count" widget="statinfo" string="Company Accounts"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_child_accounts" icon="fa-sitemap"
                                invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="Child Accounts"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_journal_items" icon="fa-list-alt"
                                invisible="journal_item_count == 0">
                            <field name="journal_item_count" widget="statinfo" string="Journal Items"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="code" string="Account Code"/>
                        <h1 class="d-flex align-items-center gap-2">
                            <field name="code" class="o_field_widget fw-bold"
                                   placeholder="e.g. 10000" style="max-width:160px"/>
                            <span class="text-muted mx-2">-</span>
                            <field name="description" placeholder="Account Name"
                                   class="flex-grow-1"/>
                        </h1>
                        <div class="d-flex gap-2 mt-1">
                            <field name="entry_type" widget="badge"
                                   decoration-muted="entry_type == 'header'"
                                   decoration-info="entry_type == 'detail'"/>
                            <field name="category"/>
                            <field name="normal_balance" widget="badge"
                                   decoration-info="normal_balance == 'debit'"
                                   decoration-warning="normal_balance == 'credit'"/>
                        </div>
                    </div>

                    <group>
                        <group string="Chart Structure">
                            <field name="active"/>
                            <field name="parent_code"/>
                            <field name="parent_id"
                                   domain="[('entry_type', '=', 'header')]"
                                   options="{'no_quick_create': True}"/>
                            <field name="fs_mapping"/>
                            <field name="subcategory"/>
                            <field name="cash_flow_classification"/>
                            <field name="cost_center"/>
                            <field name="kernel_version"/>
                            <field name="kernel_layer"/>
                            <field name="kernel_required"/>
                            <field name="master_account_id"/>
                            <field name="activity_tag"
                                   invisible="kernel_layer != 'L3'"/>
                            <field name="functional_group"
                                   invisible="kernel_layer != 'L3'"/>
                            <field name="rollup_to_l1_parent"
                                   invisible="kernel_layer != 'L3'"/>
                            <field name="analytic"
                                   invisible="kernel_layer != 'L3'"/>
                            <field name="dashboard_account_sets"
                                   invisible="kernel_layer != 'L3'"/>
                        </group>
                        <group string="Accounting Behavior">
                            <field name="odoo_account_type"/>
                            <field name="gaap_classification"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="bridge_rule_count" readonly="1"/>
                            <field name="linked_account_count" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Narrative">
                            <group>
                                <field name="long_description" nolabel="1"/>
                            </group>
                            <group>
                                <field name="detailed_description" nolabel="1"/>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1"/>
                            </group>
                        </page>

                        <page string="Controls &amp; Compliance">
                            <group>
                                <group string="Tagging">
                                    <field name="tags"/>
                                    <field name="default_vendors"/>
                                </group>
                                <group string="References">
                                    <field name="regulatory_mapping" nolabel="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Child Accounts" invisible="entry_type != 'header'">
                            <field name="child_ids" nolabel="1">
                                <list default_order="code asc">
                                    <field name="code"/>
                                    <field name="description"/>
                                    <field name="subcategory"/>
                                    <field name="odoo_account_type"/>
                                    <field name="normal_balance"/>
                                    <field name="linked_account_count" string="Company Accts"/>
                                </list>
                            </field>
                        </page>

                        <page string="Bridge Rules">
                            <field name="bridge_rule_ids" readonly="1">
                                <list>
                                    <field name="match_acct_num"/>
                                    <field name="match_name"/>
                                    <field name="match_account_type"/>
                                    <field name="match_account_subtype"/>
                                    <field name="canonical_code"/>
                                    <field name="canonical_name"/>
                                </list>
                            </field>
                        </page>

                        <page string="Company Accounts">
                            <field name="linked_account_ids" readonly="1">
                                <list>
                                    <field name="company_ids" widget="many2many_tags"/>
                                    <field name="placeholder_code" string="Code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                    <field name="qbo_id"/>
                                    <field name="qbo_realm_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qbo_standard_account_dashboard" model="ir.ui.view">
        <field name="name">qbo.standard.account.dashboard</field>
        <field name="model">qbo.standard.account</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category"
                    class="qbo_master_chart_dashboard"
                    group_create="false"
                    quick_create="false"
                    sample="1">
                <field name="code"/>
                <field name="description"/>
                <field name="entry_type"/>
                <field name="category"/>
                <field name="child_count"/>
                <field name="bridge_rule_count"/>
                <field name="linked_account_count"/>
                <field name="journal_item_count"/>
                <field name="category_slug"/>

                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_kanban_record p-3 qbo_mc_dash_#{record.category_slug.value}">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="fw-bold text-primary" t-esc="record.code.value"/>
                                    <strong class="d-block" t-esc="record.description.value"/>
                                </div>
                                <span t-if="record.entry_type.raw_value == 'header'"
                                      class="badge bg-secondary">Header</span>
                            </div>
                            <div class="mt-3 row text-center g-0">
                                <div class="col border-end">
                                    <div class="fw-bold fs-5" t-esc="record.child_count.value or 0"/>
                                    <small class="text-muted">Children</small>
                                </div>
                                <div class="col border-end">
                                    <div class="fw-bold fs-5" t-esc="record.bridge_rule_count.value or 0"/>
                                    <small class="text-muted">Rules</small>
                                </div>
                                <div class="col border-end">
                                    <div class="fw-bold fs-5" t-esc="record.linked_account_count.value or 0"/>
                                    <small class="text-muted">Accounts</small>
                                </div>
                                <div class="col">
                                    <div class="fw-bold fs-5" t-esc="record.journal_item_count.value or 0"/>
                                    <small class="text-muted">Entries</small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_qbo_standard_account" model="ir.actions.act_window">
        <field name="name">Master Accounts</field>
        <field name="res_model">qbo.standard.account</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_qbo_standard_account_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Import the master chart of accounts to start standardizing umbrella-company reporting.
            </p>
            <p>
                Headers explain the reporting structure. Detail accounts show what gets published to company charts and
                linked to QBO bridge rules.
            </p>
        </field>
    </record>

    <record id="action_qbo_standard_account_dashboard" model="ir.actions.act_window">
        <field name="name">Master Chart Overview</field>
        <field name="res_model">qbo.standard.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_qbo_standard_account_dashboard"/>
        <field name="search_view_id" ref="view_qbo_standard_account_search"/>
        <field name="context">{'search_default_filter_header': 1}</field>
    </record>
</odoo>
