<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="poseidon_mapping_propagation_wizard_view_form" model="ir.ui.view">
    <field name="name">poseidon.mapping.propagation.wizard.form</field>
    <field name="model">poseidon.mapping.propagation.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="decision_id"/>
            <field name="group_id"/>
            <field name="mode"/>
            <field name="propagation_id" readonly="1"/>
            <field name="can_commit" invisible="1"/>
          </group>
          <field name="line_ids" readonly="1">
            <list>
              <field name="company_id"/>
              <field name="status"/>
              <field name="source_account_id"/>
              <field name="target_account_id"/>
              <field name="existing_decision_id"/>
              <field name="existing_rule_id"/>
              <field name="new_rule_id"/>
              <field name="message"/>
            </list>
          </field>
        </sheet>
        <footer>
          <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
          <button name="action_commit" type="object" string="Commit" class="btn-primary" invisible="not can_commit"/>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
